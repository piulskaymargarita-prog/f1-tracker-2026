<Window x:Class="F1Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F1 Tracker — проверка слоя данных"
        Height="520" Width="820"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoText" FontSize="16" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <DataGrid x:Name="DriversGrid" Grid.Row="1"
                  IsReadOnly="True" AutoGenerateColumns="True"/>
    </Grid>
</Window>