<Window x:Class="F1Tracker.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:F1Tracker.Views.Controls"
        Title="F1 Tracker — Администрирование"
        Height="720" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <c:AppHeader ActivePage="Admin"/>
        <c:BreadcrumbBar x:Name="Crumbs" Grid.Row="1" Trail="Главная/Администрирование"/>

        <Grid Grid.Row="2" Style="{StaticResource PageRoot}">
            <Grid Margin="32,8,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="ПОЛЬЗОВАТЕЛИ" CommandParameter="users" Height="40"
                            Style="{StaticResource NavButton}" Click="Tab_Click"/>
                    <Button Content="ЖУРНАЛ ДЕЙСТВИЙ" CommandParameter="log" Height="40"
                            Style="{StaticResource NavButton}" Click="Tab_Click"/>
                </StackPanel>

                <!-- ===== Пользователи ===== -->
                <Grid x:Name="UsersPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="True"
                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                                  SelectionChanged="UsersGrid_SelectionChanged"/>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" Style="{StaticResource CaptionText}"/>

                                <TextBlock Text="Логин (латиница, цифры, . _ -)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoginBox" MaxLength="32"/>

                                <TextBlock Text="Пароль (минимум 6 символов)" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="PassBox" MaxLength="64"/>

                                <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RoleCombo" SelectedValuePath="Content" SelectedIndex="0">
                                    <ComboBoxItem Content="user"/>
                                    <ComboBoxItem Content="admin"/>
                                </ComboBox>

                                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap" MinHeight="36" Margin="0,12,0,0"/>
                                <TextBlock x:Name="InfoText" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Button Content="СОЗДАТЬ ПОЛЬЗОВАТЕЛЯ" Style="{StaticResource PrimaryButton}"
                                        Click="CreateUser_Click"/>
                                <TextBlock Text="Кнопки ниже действуют на пользователя, выбранного в таблице:"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,4"/>
                                <Button Content="СОХРАНИТЬ РОЛЬ" Style="{StaticResource GhostButton}"
                                        Margin="0,4,0,0" Click="ChangeRole_Click"/>
                                <Button Content="СМЕНИТЬ ПАРОЛЬ" Style="{StaticResource GhostButton}"
                                        Margin="0,8,0,0" Click="ChangePassword_Click"/>
                                <Button Content="УДАЛИТЬ" Style="{StaticResource DangerButton}"
                                        Margin="0,8,0,0" Click="DeleteUser_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== Журнал ===== -->
                <Grid x:Name="LogPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ПОИСК" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="LogFilterBox" Width="320" MaxLength="50"
                                     ToolTip="Пользователь, действие или детали"
                                     TextChanged="LogFilterBox_TextChanged"/>
                            <Button Content="ОБНОВИТЬ" Style="{StaticResource GhostButton}"
                                    Margin="16,0,0,0" Padding="18,8" Click="RefreshLog_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="LogCountText" Style="{StaticResource MonoText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="LogGrid" AutoGenerateColumns="True"
                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <c:AppFooter Grid.Row="3"/>
    </Grid>
</Window>