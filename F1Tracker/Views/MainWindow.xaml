<Window x:Class="F1Tracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:F1Tracker.Views.Controls"
        Title="F1 Tracker 2026 — Главная"
        Height="720" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <!-- ============ АНИМАЦИЯ ФОНА: стартует сама при загрузке окна и идёт бесконечно ============ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Дрейфующий градиент -->
                    <DoubleAnimation Storyboard.TargetName="GsMid" Storyboard.TargetProperty="Offset"
                                     From="0.2" To="0.8" Duration="0:0:9"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                    <ColorAnimation Storyboard.TargetName="GsMid" Storyboard.TargetProperty="Color"
                                    From="#2A0A12" To="#101C3E" Duration="0:0:12"
                                    AutoReverse="True" RepeatBehavior="Forever"/>
                    <!-- Плывущее красное свечение -->
                    <DoubleAnimation Storyboard.TargetName="GlowT" Storyboard.TargetProperty="X"
                                     From="-200" To="900" Duration="0:0:14"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="GlowT" Storyboard.TargetProperty="Y"
                                     From="-100" To="250" Duration="0:0:9"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                    <!-- «Линии скорости» -->
                    <DoubleAnimation Storyboard.TargetName="L1T" Storyboard.TargetProperty="X"
                                     From="-400" To="2600" Duration="0:0:4.5" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="L2T" Storyboard.TargetProperty="X"
                                     From="-400" To="2600" Duration="0:0:6.5" BeginTime="0:0:1.2" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="L3T" Storyboard.TargetProperty="X"
                                     From="-400" To="2600" Duration="0:0:3.8" BeginTime="0:0:2.1" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="L4T" Storyboard.TargetProperty="X"
                                     From="-400" To="2600" Duration="0:0:7" BeginTime="0:0:0.6" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="L5T" Storyboard.TargetProperty="X"
                                     From="-400" To="2600" Duration="0:0:5.2" BeginTime="0:0:3" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid ClipToBounds="True">

        <!-- ===== СЛОЙ ФОНА ===== -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D0D1A" Offset="0"/>
                    <GradientStop x:Name="GsMid" Color="#2A0A12" Offset="0.2"/>
                    <GradientStop Color="#0D0D1A" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Fill="{StaticResource GlowBrush}" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="GlowT" X="-200" Y="-100"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="1" Height="2" Width="280" HorizontalAlignment="Left" Opacity="0.35"
                       Fill="{StaticResource SpeedLineBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="L1T" X="-400"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Grid.Row="2" Height="2" Width="180" HorizontalAlignment="Left" Opacity="0.25"
                       Fill="{StaticResource SpeedLineBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="L2T" X="-400"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Grid.Row="3" Height="3" Width="340" HorizontalAlignment="Left" Opacity="0.30"
                       Fill="{StaticResource SpeedLineBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="L3T" X="-400"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Grid.Row="5" Height="2" Width="220" HorizontalAlignment="Left" Opacity="0.22"
                       Fill="{StaticResource SpeedLineBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="L4T" X="-400"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Grid.Row="6" Height="2" Width="300" HorizontalAlignment="Left" Opacity="0.30"
                       Fill="{StaticResource SpeedLineBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="L5T" X="-400"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- ===== КОНТЕНТ ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <c:AppHeader ActivePage="Main"/>
            <c:BreadcrumbBar Grid.Row="1" Trail="Главная"/>

            <!-- Появление экрана: fade + slide -->
            <Grid Grid.Row="2" Style="{StaticResource PageRoot}">
                <Grid Margin="32,8,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock x:Name="WelcomeText" Style="{StaticResource Heading1}"/>
                        <TextBlock x:Name="RoleDescText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Счётчики -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="КОМАНДЫ" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="TeamsCount" Style="{StaticResource BigNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ПИЛОТЫ" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="DriversCount" Style="{StaticResource BigNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ГРАН-ПРИ" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="GpCount" Style="{StaticResource BigNumber}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ЗАПИСЕЙ РЕЗУЛЬТАТОВ" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="ResultsCount" Style="{StaticResource BigNumber}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Три панели -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ближайший Гран-при -->
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="БЛИЖАЙШИЙ ГРАН-ПРИ" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="NextRaceName" Grid.Row="1" Style="{StaticResource Heading2}"
                                           Margin="0,8,0,2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="NextRaceCircuit" Grid.Row="2" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="NextRaceCountdown" Style="{StaticResource BigNumber}"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock x:Name="NextRaceDate" Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <Button Content="ДАННЫЕ" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,10,0" Click="OpenData_Click"/>
                                    <Button Content="СТАТИСТИКА" Style="{StaticResource GhostButton}"
                                            Click="OpenStats_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Топ-5 пилотов -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ТОП-5 ПИЛОТОВ (ПО ДЕМО-ДАННЫМ)" Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,14"/>
                                <ItemsControl x:Name="LeadersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Pos]}" Style="{StaticResource MonoText}"
                                                           FontWeight="Bold" FontSize="20"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding [Driver]}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding [Team]}" Style="{StaticResource MutedText}"
                                                               FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding [Points]}"
                                                           Style="{StaticResource MonoText}" FontWeight="Bold" FontSize="20"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Калькулятор очков -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="КАЛЬКУЛЯТОР ОЧКОВ" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="Позиция на финише (1–22)" Style="{StaticResource MutedText}"
                                           Margin="0,14,0,6"/>
                                <TextBox x:Name="PositionBox" MaxLength="2" Width="100" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <RadioButton x:Name="RaceRadio" Content="Гонка" IsChecked="True"
                                                 Foreground="{StaticResource TextBrush}" Margin="0,0,18,0"/>
                                    <RadioButton x:Name="SprintRadio" Content="Спринт"
                                                 Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <Button Content="РАССЧИТАТЬ" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,18,0,0" Click="Calc_Click"/>
                                <TextBlock x:Name="CalcResult" Style="{StaticResource BigNumber}"
                                           Margin="0,18,0,0" Text="—"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <c:AppFooter Grid.Row="3"/>
        </Grid>
    </Grid>
</Window>