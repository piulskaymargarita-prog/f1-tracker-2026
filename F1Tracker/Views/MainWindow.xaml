<Window x:Class="F1Tracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F1 Tracker — после входа"
        Height="360" Width="620"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource AppWindow}">
	<StackPanel Margin="32" VerticalAlignment="Center">
		<TextBlock x:Name="WhoText" FontSize="22"/>
		<TextBlock x:Name="RoleText" Margin="0,8,0,0"/>
		<TextBlock x:Name="AdminOnlyText" Margin="0,8,0,0" Visibility="Collapsed"
                   Text="✔ Админ: доступно управление пользователями и журналом."/>
		<Button Content="ВЫЙТИ" Margin="0,24,0,0" HorizontalAlignment="Left"
                Style="{DynamicResource GhostButton}" Click="Logout_Click"/>
	</StackPanel>
</Window>