<Window x:Class="F1Tracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F1 Tracker — Вход"
        Height="620" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource AppWindow}">

	<Grid Style="{DynamicResource PageRoot}">
		<Border Style="{DynamicResource Card}" Background="{DynamicResource PanelBrush}"
                Margin="32" Padding="32" VerticalAlignment="Center">
			<StackPanel>

				<!-- Логотип -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
					<Grid>
						<Border Background="{DynamicResource AccentBrush}" CornerRadius="4"
                                Width="56" Height="38" RenderTransformOrigin="0.5,0.5">
							<Border.RenderTransform>
								<SkewTransform AngleX="-14"/>
							</Border.RenderTransform>
						</Border>
						<TextBlock Text="F1" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold"
                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Grid>
					<StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
						<TextBlock Text="TRACKER 2026" FontFamily="{DynamicResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18"/>
						<TextBlock Text="Учёт турниров Формулы-1" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"/>
					</StackPanel>
				</StackPanel>

				<TextBlock Text="Вход в систему" Style="{DynamicResource Heading2}" Margin="0,0,0,18"/>

				<TextBlock Text="Логин" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
				<TextBox x:Name="UsernameBox" MaxLength="32" Margin="0,0,0,14"/>

				<TextBlock Text="Пароль" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
				<PasswordBox x:Name="PasswordInput" MaxLength="64"/>

				<TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" MinHeight="40" Margin="0,10,0,6"/>

				<Button x:Name="LoginButton" Content="ВОЙТИ" IsDefault="True"
                        Style="{DynamicResource PrimaryButton}" Click="LoginButton_Click"/>

				<!-- Подсказка для учебного стенда; в реальном приложении удалить -->
				<TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Тестовые учётки: admin / Admin123!   ·   user / User123!"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>